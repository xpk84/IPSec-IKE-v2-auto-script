# IKEv2-server-autoscript - xpk84 fork v2.3 (2026-10-23)
# Import on RouterOS: /import IKEv2-server-autoscript.rsc   (creates/replaces script IKEv2_run_to_create)
# Diff vs upstream: see README.fork.md
/system script
add dont-require-permissions=no name=IKEv2_run_to_create owner=admin comment="IKEv2 peer automation, xpk84 fork v2.3 - RUN ONLY from terminal: /system script run IKEv2_run_to_create (WinBox Run button fails)" policy=ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon source="# IKEv2-server-autoscript - xpk84 fork v2.3 (2026-10-23)\r\n# RUN: /system script run IKEv2_run_to_create -- ONLY from a terminal (WinBox: New Terminal, or ssh).\r\n# The WinBox Run button FAILS ('missing value(s) of argument(s) value'): interactive prompts need a live console.\r\n# Base: github.com/mikrotik-user/IPSec-IKE-v2-auto-script (frozen 2022-01-13)\r\n# v2.0: password >=8 chars, not echoed; create-peer asks certificate validity (Enter = random 330-395);\r\n#       rollback/revoke fully remove cert/p12/rollback-script; crypto: dh-group=modp2048, no sha1/aes-192.\r\n# v2.1: prompts carry generic examples (hostname/IP, peer name pattern, password wording, validity hint).\r\n# v2.2: fix RouterOS parse error - no \$var interpolation inside command-call string args (concat instead);\r\n#       real expiry date printed from the signed certificate; IKEv2-rollback generator carries WARNING.\r\n# v2.3: all prompt examples masked - no real domains, IPs or usernames baked in (public-repo safe);\r\n#       peer name hint uses live pattern ike2_<user>_<device>_<current year>.\r\n# Requires RouterOS 7.13+ (:rnd).\r\n:local variant\r\n:local Hostname\r\n:local IPaddress \r\n:local Country\r\n:local State\r\n:local CertFile\r\n:local arrayRollback [ :toarray \"\" ]\r\n:local err \"false\"\r\n:local PeerName\r\n:local Password\r\n\r\n:local inputFunc do={:put \$1;:return}\r\n:local checkHostnameFunc do={\r\n    :local hostname \$1\r\n    :if ([:len \$hostname]=0) do={\r\n         :if ([/ip cloud get value-name=ddns-enabled] = false) do {\r\n             /ip cloud set ddns-enabled=yes\r\n             :delay 10s\r\n         } \r\n    :set \$hostname [/ip cloud get value-name=dns-name]\r\n    :if ([:len \$hostname]=0) do={\r\n         :return \"\"\r\n        }\r\n    }\r\n    return \$hostname\r\n}\r\n:local checkIpAddressFunc do={\r\n    :if ([:tostr \$1] = [:toip \$1]) do={:return \$1} else={:return \"\"}\r\n}\r\n\r\n:put (\"\\r\\n\\\r\n     ##############################################################################\\r\\n\\\r\n     Welcome to IPSec-auto-script. This script will install and setup IPSec server.\\r\\n\\\r\n     ##############################################################################\\r\\n\\r\\n\")\r\n:put (\"What would you like to do\\\?\\r\\n\\\r\n       1. Install IKE v2 server\\r\\n\\\r\n       2. Create peer\\r\\n\\\r\n       3. Revoke peer\\r\\n\\\r\n       4. Remove IKE v2 server\\r\\n\")\r\n:set variant [\$inputFunc \"Choose corresponding number.\"]\r\n:if (variant = 1) do={\r\n    :put \"\"\r\n    :set Hostname  [\$inputFunc \"Input domain name of this server. (Example: vpn.example.com. Press ENTER to auto-detect from /ip cloud)\"]\r\n    :set \$Hostname [\$checkHostnameFunc \$Hostname]\r\n    :if (\$Hostname = \"\") do={\r\n         :put \"Error: cannot get DNS name\"\r\n         :set err \"true\"\r\n        }\r\n    do {\r\n        :put \"\"\r\n        :local ResolvedIP \"\"\r\n        :do {:set ResolvedIP [:resolve \$Hostname]} on-error={}\r\n        :if ([:typeof \$ResolvedIP] = \"ip\") do={\r\n            :set IPaddress [\$inputFunc (\"Input IP address of this server. (Press ENTER to use \" . \$ResolvedIP . \")\")]\r\n        } else={\r\n            :set IPaddress [\$inputFunc \"Input IP address of this server. (Example: 203.0.113.10)\"]\r\n        }\r\n        :if ([:len \$IPaddress]=0) do={\r\n             do {:set \$IPaddress [:resolve \$Hostname]} on-error={\r\n                 :put \"Error: cannot resolve DNS name\"\r\n                }\r\n            }\r\n        :set IPaddress [\$checkIpAddressFunc \$IPaddress]\r\n        } while=( [:len \$IPaddress]=0 )\r\n    :put \"\"\r\n    :set Country   [\$inputFunc \"Input Country of server location. E.g.: DE\"]\r\n    :put \"\"\r\n    :set State     [\$inputFunc \"Input State of server location. E.g.: Frankfurt\"]\r\n    \r\n    :put \"\\r\\nChecking if script can use given parameters\\r\\n\"\r\n    :if ([/certificate find name=\"CA.\$Hostname\"] != \"\") do={\r\n             :put \"Error: certificate CA.\$Hostname already exists\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: certificate name CA.\$Hostname\"\r\n        }\r\n\r\n    :if ([/certificate find name=\"\$Hostname\"] != \"\") do={\r\n             :put \"Error: certificate \$Hostname already exists\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: certificate name \$Hostname\"\r\n        }\r\n\r\n    :if ([/certificate find name=\"~client-template@\$Hostname\"] != \"\") do={\r\n             :put \"Error: certificate template ~client-template@\$Hostname already exists\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: certificate template name ~client-template@\$Hostname\"\r\n        }\r\n\r\n    :if ([/file find name=\"CA.\$Hostname.crt\"] != \"\") do={\r\n             :put \"Error: file CA.\$Hostname.crt already exists\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: file name CA.\$Hostname.crt\"\r\n        }\r\n\r\n    :if ([/int bridge find name=\"bridge-vpn\"] != \"\") do={\r\n             :put \"Error: bridge bridge-vpn already exists\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: bridge name bridge-vpn\"\r\n        }\r\n\r\n    :if ([/ip address find address=\"10.0.88.1/24\"] != \"\") do={\r\n             :put \"Error: ip address 10.0.88.1/24 already exists\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: ip address 10.0.88.1/24\"\r\n        }\r\n\r\n    :if ([/ip pool find name=\"pool-\$Hostname\"] != \"\") do={\r\n             :put \"Error: ip pool pool-\$Hostname already exists\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: ip pool name pool-\$Hostname\"\r\n        }\r\n\r\n    :if ([/ip ipsec mode-config find name=\"modeconf-\$Hostname\"] != \"\") do={\r\n             :put \"Error: mode-config modeconf-\$Hostname already exists\"\r\n             :set err \"true\"\r\n        } else {\r\n              :put \"OK: mode-config name modeconf-\$Hostname\"\r\n        }\r\n\r\n    :if ([/ip ipsec profile find name=\"profile-\$Hostname\"] != \"\") do={\r\n             :put \"Error: ipsec profile profile-\$Hostname already exists\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: ipsec profile name profile-\$Hostname\"\r\n        }\r\n\r\n    :if ([/ip ipsec peer find name=\"peer-\$IPaddress\"] !=\"\") do={\r\n            :put \"Error: ipsec peer peer-\$IPaddress already exists\"\r\n            :set err \"true\"\r\n        } else {\r\n             :put \"OK: ipsec peer name peer-\$IPaddress\"\r\n        }\r\n\r\n    :if ([/ip ipsec proposal find name=\"proposal-\$Hostname\"] != \"\") do={\r\n             :put \"Error: ipsec proposal proposal-\$Hostname already exists\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: ipsec proposal name proposal-\$Hostname\"\r\n        }\r\n\r\n    :if ([/ip ipsec policy group find name=\"group-\$Hostname\"] != \"\") do={\r\n             :put \"Error: ipsec policy group group-\$Hostname already exists\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: ipsec policy group name group-\$Hostname\"\r\n        }\r\n\r\n    :if ([/ip ipsec policy find dst-address=\"10.0.88.0/24\" ] != \"\") do={\r\n         :put \"Error: ipsec policy for dst-address=10.0.88.0/24 already exists\"\r\n         :set err \"true\"\r\n        } else {\r\n             :put \"OK: ipsec policy for dst-address=10.0.88.0/24\"\r\n        }\r\n    :if (\$err = \"true\") do={:error \"\\r\\nPrecheck failed\"} else={:put \"\\r\\nPrecheck OK\"}\r\n    :put \"\\r\\n\"\r\n    :put \"Hostname is: \$Hostname\"\r\n    :put \"IP address is: \$IPaddress\"\r\n    :put \"Country is: \$Country\"\r\n    :put \"State is: \$State\"\r\n    :put \"\"\r\n    :if ([\$inputFunc \"Continue\? [y/n]\"]=\"n\") do={:error \"Script stopped by user request\"}\r\n    :put \"\\r\\nGenerating CA SSL certificate\"\r\n    :do {/certificate \r\n         add name=\"CA.\$Hostname\" country=\$Country state=\$State locality=City \\\r\n         organization=\"\$Hostname\" common-name=\"CA.\$Hostname\"  subject-alt-name=\"DNS:CA.\$Hostname\"  \\\r\n         key-size=4096 days-valid=3650 trusted=yes key-usage=digital-signature,key-encipherment,data-encipherment,key-cert-sign,crl-sign\r\n         :set arrayRollback ( \$arrayRollback, \":do {/certificate remove [ find name=\\\"CA.\$Hostname\\\"]} on-error={} \" )\r\n         } on-error={\r\n             :put \"Error: Cannot add certificate CA.\$Hostname\"\r\n             :set err \"true\"\r\n             :return \"\"\r\n        }\r\n\r\n    :put \"Signing CA SSL certificate (Certificate Authority)\"\r\n    :delay 1\r\n    :do {/certificate sign \"CA.\$Hostname\"} on-error={\r\n         :put \"Error: Cannot sign CA.\$Hostname\"\r\n         :set err \"true\"\r\n         :return \"\"\r\n    }\r\n\r\n    :put \"Generating server SSL certificate\"\r\n    :do {/certificate \r\n        add name=\"\$Hostname\" country=\$Country state=\$State locality=\"City\" organization=\"\$Hostname\" common-name=\"\$Hostname\" \\\r\n        subject-alt-name=\"DNS:\$Hostname\" key-size=2048 days-valid=1095 trusted=yes key-usage=tls-server\r\n        :set arrayRollback ( \$arrayRollback, \":do {/certificate remove [ find name=\\\"\$Hostname\\\"]} on-error={} \" )\r\n            } on-error={\r\n                 :put \"Error: Cannot add certificate \$Hostname\"\r\n                 :set err \"true\"\r\n                 :return \"\"\r\n    }\r\n\r\n    :put \"Signing server certificate with CA.\$Hostname\"\r\n    :delay 1\r\n    :do {/certificate sign \"\$Hostname\" ca=\"CA.\$Hostname\"} on-error={\r\n         :put \"Cannot sign \$Hostname with CA.\$Hostname\"\r\n         :set err \"true\"\r\n         :return \"\"\r\n    }\r\n\r\n    :put \"Creating template for signing clients\"\r\n    :do {/certificate\r\n       add name=\"~client-template@\$Hostname\" country=\$Country state=\$State locality=\"City\" organization=\"\$Hostname\" common-name=\"~client-template@\$Hostname\" \\\r\n       subject-alt-name=\"email:~client-template@\$Hostname\" key-size=2048 days-valid=365 trusted=yes key-usage=tls-client\r\n       :set arrayRollback ( \$arrayRollback, \":do {/certificate remove [ find name~\\\"~client-template\\\"]} on-error={} \" )\r\n            } on-error={\r\n                 :put \"Cannot add client-template@\$Hostname\"\r\n                 :set err \"true\"\r\n                 :return \"\"\r\n    }\r\n\r\n    :put \"Exporting CA certificate to file CA.\$Hostname\"\r\n    :do {/certificate export-certificate \"CA.\$Hostname\" type=pem file-name=\"CA.\$Hostname\"} on-error={\r\n         :put \"Cannot export-certificate CA.\$Hostname\"\r\n         :set err \"true\"\r\n         :return \"\"\r\n    }\r\n\r\n    :put \"Create IKEv2 server\"\r\n    :do {/interface bridge add name=\"bridge-vpn\"\r\n        :set arrayRollback ( \$arrayRollback, \"/interface bridge remove [find name=\\\"bridge-vpn\\\"]\" )\r\n        } on-error={\r\n             :put \"bridge bridge-vpn already exists\"\r\n             :set err \"true\"\r\n             :return \"\"\r\n    }\r\n    :do {/ip address add address=10.0.88.1/24 interface=\"bridge-vpn\" network=10.0.88.0\r\n        :set arrayRollback ( \$arrayRollback, \"/ip address remove [find address=\\\"10.0.88.1/24\\\"]\" )\r\n        } on-error={\r\n             :put \"Cannot add ip address (10.0.88.1/24) on interface bridge-vpn\"\r\n             :set err \"true\"\r\n             :return \"\"\r\n    }\r\n    :do {/ip pool add name=\"pool-\$Hostname\" ranges=10.0.88.2-10.0.88.254\r\n        :set arrayRollback ( \$arrayRollback, \"/ip pool remove [find name=\\\"pool-\$Hostname\\\"]\" )\r\n        } on-error={\r\n             :put \"IP pool (10.0.88.2-10.0.88.254) already exists\"\r\n             :set err \"true\"\r\n             :return \"\"\r\n    }\r\n\r\n    :put \"Create new IPSec mode config\"\r\n    :do {/ip ipsec mode-config add address-pool=\"pool-\$Hostname\" address-prefix-length=32 name=\"modeconf-\$Hostname\" split-include=0.0.0.0/0 static-dns=10.0.88.1 system-dns=no\r\n        :set arrayRollback ( \$arrayRollback, \"/ip ipsec mode-config remove [ find name=\\\"modeconf-\$Hostname\\\"]\" )\r\n        } on-error={\r\n             :put \"Cannot create modeconf-\$Hostname or it already exists\"\r\n             :set err \"true\"\r\n             :return \"\"\r\n    }\r\n\r\n    :put \"Create new IPSec peer profile (phase 1)\"\r\n    :do {/ip ipsec profile add dh-group=modp2048 enc-algorithm=aes-256,aes-128 hash-algorithm=sha256 name=\"profile-\$Hostname\" nat-traversal=yes proposal-check=obey \r\n        :set arrayRollback ( \$arrayRollback, \"/ip ipsec profile remove  [ find name=\\\"profile-\$Hostname\\\"]\" )\r\n        } on-error={\r\n             :put \"Cannot create profile-\$Hostname or it already exists\"\r\n             :set err \"true\"\r\n             :return \"\"\r\n    }\r\n\r\n    :put \"Create new IPSec peer using public IP address (mode IKE2)\"\r\n    :do {/ip ipsec peer add exchange-mode=ike2 address=0.0.0.0/0 local-address=\"\$IPaddress\" name=\"peer-\$IPaddress\" passive=yes send-initial-contact=yes profile=\"profile-\$Hostname\"\r\n       :set arrayRollback ( \$arrayRollback, \"/ip ipsec peer remove  [ find name=\\\"peer-\$IPaddress\\\"]\" )\r\n       } on-error={\r\n             :put \"Cannot create ipsec peer-\$IPaddress or it already exists\"\r\n             :set err \"true\"\r\n             :return \"\"\r\n    }\r\n\r\n    :put \"Create new IPSec proposal (phase 2)\"\r\n    :do {/ip ipsec proposal add auth-algorithms=sha512,sha256 enc-algorithms=aes-256-cbc,aes-256-ctr,aes-256-gcm,aes-128-cbc,aes-128-ctr,aes-128-gcm lifetime=8h name=\"proposal-\$Hostname\" pfs-group=none\r\n        :set arrayRollback ( \$arrayRollback, \"/ip ipsec proposal remove [find name=\\\"proposal-\$Hostname\\\"]\" )\r\n        } on-error={\r\n             :put \"Cannot create ipsec proposal-\$Hostname or it already exists\"\r\n             :set err \"true\"\r\n             :return \"\"\r\n    }\r\n\r\n    :put \"Create new IPSec policy group\"\r\n    :do {/ip ipsec policy group add name=\"group-\$Hostname\"\r\n       :set arrayRollback ( \$arrayRollback, \"/ip ipsec policy group remove [find name=\\\"group-\$Hostname\\\"]\" )\r\n       } on-error={\r\n             :put \"Cannot create policy group-\$Hostname or it already exists\"\r\n             :set err \"true\"\r\n             :return \"\"\r\n    }\r\n\r\n    :put \"Create new template IPSec policy\"\r\n    :do {/ip ipsec policy add dst-address=10.0.88.0/24 group=\"group-\$Hostname\" proposal=\"proposal-\$Hostname\" src-address=0.0.0.0/0 template=yes\r\n        :set arrayRollback ( \$arrayRollback, \"/ip ipsec policy remove [find dst-address=10.0.88.0/24 group=\\\"group-\$Hostname\\\" proposal=\\\"proposal-\$Hostname\\\" src-address=0.0.0.0/0]\" )\r\n        } on-error={\r\n             :put \"Cannot create ipsec policy dst-address=10.0.88.0/24 src-address=0.0.0.0/0 or it already exists\"\r\n             :set err \"true\"\r\n             :return \"\"\r\n    }\r\n    \r\n    :local scr\r\n    :local ln\r\n    :set arrayRollback ( \$arrayRollback, \":if ([\\\$inputFunc \\\"Continue\? [y/n]\\\"]=\\\"n\\\") do={:error \\\"Script stopped by user request\\\"}\" )\r\n    :set arrayRollback ( \$arrayRollback, \":local inputFunc do={:put \\\$1;:return}\")\r\n    :set arrayRollback ( \$arrayRollback, \":put \\\"This script will remove IPSec IKEv2. Make sure you already removed existing peers.\\\" \" )\r\n    :set scr \"# WARNING: IKEv2-rollback removes the WHOLE IKEv2 server (L2TP-certs VPN): CA, server cert, client template, pool, mode-config, identities, policies. All peers lose access. Irreversible!\"\r\n    :for x from=[:len \$arrayRollback] to=0 step=-1 do={\r\n         :set ln [:pick \$arrayRollback \$x] \r\n         :if ([:len \$ln]!=0) do={:set scr (\$scr.\"\\r\\n\".\$ln)}\r\n    }\r\n    \r\n    /system script remove [find name=\"IKEv2-rollback\"]\r\n    /system script\r\n         add dont-require-permissions=no name=\"IKEv2-rollback\" owner=admin policy=\\\r\n         ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon source=\"\$scr\"\r\n    :put \"\\r\\nGenerated IKEv2-rollback script.\"\r\n    }\r\n\r\n:if (variant = 2) do={\r\n    :put \"\"\r\n    :set Hostname  [\$inputFunc \"Input domain name of this server. (Example: vpn.example.com. Press ENTER to auto-detect from /ip cloud)\"]\r\n    :set \$Hostname [\$checkHostnameFunc \$Hostname]\r\n    :if (\$Hostname = \"\") do={\r\n         :put \"Error: cannot get DNS name of this router.\"\r\n         :set err \"true\"\r\n        }\r\n    :put \"\"\r\n    :do {\r\n        :local ResolvedIP \"\"\r\n        :do {:set ResolvedIP [:resolve \$Hostname]} on-error={}\r\n        :if ([:typeof \$ResolvedIP] = \"ip\") do={\r\n            :set IPaddress [\$inputFunc (\"Input IP address of this server. (Press ENTER to use \" . \$ResolvedIP . \")\")]\r\n        } else={\r\n            :set IPaddress [\$inputFunc \"Input IP address of this server. (Example: 203.0.113.10)\"]\r\n        }\r\n        :if ([:len \$IPaddress]=0) do={\r\n             do {:set \$IPaddress [:resolve \$Hostname]} on-error={\r\n                 :put \"Error: cannot resolve DNS name\"\r\n                }\r\n            }\r\n        :set IPaddress [\$checkIpAddressFunc \$IPaddress]\r\n        } while=( [:len \$IPaddress]=0 )\r\n    :put \"\"\r\n    :local Year [:pick [/system clock get date] 0 4]\r\n    :set PeerName [\$inputFunc (\"Input peer name. (Pattern: ike2_<user>_<device>_\" . \$Year . \" - the certificate will be <peername>@\" . \$Hostname . \")\")]\r\n    :put \"\"\r\n    :do {\r\n         :set Password [\$inputFunc \"Input password to encrypt certificate file (at least 8 characters).\"]\r\n         } while=( [:len \$Password]<8 )\r\n    :put \"\"\r\n    :local CertDays\r\n    :local ValidityHint \"Press ENTER = random 330-395 days (recommended). Example: 365 days = ~12 months\"\r\n    :set CertDays [\$inputFunc (\"Input certificate validity in days. (\" . \$ValidityHint . \")\")]\r\n    :set CertDays [:tonum \$CertDays]\r\n    :if ([:typeof \$CertDays] != \"num\") do={\r\n        :put \"  invalid number, falling back to 365\"\r\n        :set CertDays 365\r\n    }\r\n    :if (\$CertDays < 30) do={\r\n        :put \"  validity too small, falling back to 365\"\r\n        :set CertDays 365\r\n    }\r\n    :put \"\\r\\nChecking if script can use given parameters\\r\\n\"\r\n    \r\n    :if ([/certificate find name=\"\$PeerName@\$Hostname\"] != \"\") do={\r\n             :put \"Error: certificate \$PeerName@\$Hostname already exists\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: certificate name \$PeerName@\$Hostname\"\r\n        }\r\n    :if ([/certificate find name=\"~client-template@\$Hostname\"] = \"\") do={\r\n             :put \"Error: there's no template ~client-template@\$Hostname\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: template ~client-template@\$Hostname\"\r\n        }\r\n    :if ([/certificate find name=\"CA.\$Hostname\"] = \"\") do={\r\n             :put \"Error: there's no CA.\$Hostname certificate\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: CA.\$Hostname certificate\"\r\n        }\r\n    :if ([/file find name=\"\$PeerName@\$Hostname.crt\"] != \"\") do={\r\n             :put \"Error: file CA.\$Hostname.crt already exists\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: file name CA.\$Hostname.crt\"\r\n        }\r\n    :if (\$err = \"true\") do={:error \"\\r\\nPrecheck failed\"} else={:put \"\\r\\nPrecheck OK\"}\r\n    :put \"\\r\\n\"\r\n    :put \"Hostname is: \$Hostname\"\r\n    :put \"PeerName is: \$PeerName\"\r\n    :put \"Certificate validity: \$CertDays days\"\r\n    :put (\"Password is: <hidden, \" . [:len \$Password] . \" chars>\")\r\n    :put \"\"\r\n    :if ([\$inputFunc \"Continue\? [y/n]\"]=\"n\") do={:error \"Script stopped by user request\"}\r\n    \r\n    :put \"Setting template validity to \$CertDays days\"\r\n    :do {/certificate set \"~client-template@\$Hostname\" days-valid=\$CertDays} on-error={\r\n        :put \"Warning: cannot set template days-valid, using template default\"\r\n    }\r\n    :put \"Creating client certificate from template\"\r\n    :do {/certificate \r\n         add copy-from=\"~client-template@\$Hostname\" name=\"\$PeerName@\$Hostname\" common-name=\"\$PeerName@\$Hostname\" subject-alt-name=\"email:\$PeerName@\$Hostname\"\r\n         :set arrayRollback ( \$arrayRollback, \":do {/system script remove [find name=\\\"\$PeerName-rollback\\\"]} on-error={}\" )\r\n         :set arrayRollback ( \$arrayRollback, \":do {/file remove [find name~\\\"\$PeerName@\$Hostname\\\"]} on-error={}\" )\r\n         :set arrayRollback ( \$arrayRollback, \":do {/certificate remove [ find name=\\\"\$PeerName@\$Hostname\\\"]} on-error={}\" )\r\n         :set arrayRollback ( \$arrayRollback, \":do {/certificate issued-revoke [ find name=\\\"\$PeerName@\$Hostname\\\"]} on-error={}\" )\r\n        } on-error={\r\n             :put \"Script error: cannot copy-from ~client-template@\$Hostname certificate\"\r\n             :set err \"true\"\r\n        }    \r\n    :put \"Signing client certificate with CA.\$Hostname\"\r\n    :do {/certificate sign \"\$PeerName@\$Hostname\" ca=\"CA.\$Hostname\" } on-error={\r\n             :put \"Script error: cannot sign client certificate \$PeerName@\$Hostname\"\r\n             :set err \"true\"\r\n        } \r\n    :do {:put (\"  certificate expires: \" . [/certificate get [find name=\"\$PeerName@\$Hostname\"] invalid-after])} on-error={}\r\n    :delay 1\r\n    :put (\"Exporting client certificate and private key\")        \r\n    :do {/certificate export-certificate \"\$PeerName@\$Hostname\" type=pkcs12 export-passphrase=\"\$Password\" file-name=\"\$PeerName@\$Hostname\"} on-error={\r\n             :put \"Script error: cannot create export-certificate \$PeerName@\$Hostname\"\r\n             :set err \"true\"\r\n        }\r\n    :put \"Assembling ipsec identity\"        \r\n    :do {/ip ipsec identity\r\n         add auth-method=digital-signature certificate=\"\$Hostname\" remote-certificate=\"\$PeerName@\$Hostname\" generate-policy=port-strict \\\r\n         match-by=certificate mode-config=\"modeconf-\$Hostname\" peer=\"peer-\$IPaddress\" policy-template-group=\"group-\$Hostname\" remote-id=\"user-fqdn:\$PeerName@\$Hostname\"\r\n         :set arrayRollback ( \$arrayRollback, \":do {/ip ipsec identity remove [find remote-id~\\\"\$PeerName@\$Hostname\\\"]} on-error={}\" )\r\n        } on-error={\r\n             :put \"Script error: cannot create ipsec identity\"\r\n             :set err \"true\"\r\n        }\r\n    :if (\$err=\"true\") do={:put \"\\r\\nThe were errors creating peer.\"}\r\n    :local scr\r\n    :local ln\r\n    :set arrayRollback ( \$arrayRollback, \":if ([\\\$inputFunc \\\"Continue\? [y/n]\\\"]=\\\"n\\\") do={:error \\\"Script stopped by user request\\\"}\" )\r\n    :set arrayRollback ( \$arrayRollback, \":local inputFunc do={:put \\\$1;:return}\")\r\n    :set arrayRollback ( \$arrayRollback, \":put \\\"This script will remove \$PeerName@\$Hostname from this server\\\" \" )\r\n    :for x from=[:len \$arrayRollback] to=0 step=-1 do={\r\n         :set ln [:pick \$arrayRollback \$x] \r\n         :if ([:len \$ln]!=0) do={:set scr (\$scr.\"\\r\\n\".\$ln)}\r\n    }\r\n\r\n    /system script remove [find name=\"\$PeerName-rollback\"]\r\n    /system script\r\n         add dont-require-permissions=no name=\"\$PeerName-rollback\" owner=admin policy=\\\r\n         ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon source=\"\$scr\"\r\n    :put \"\\r\\nGenerated \$PeerName-rollback script.\"\r\n    :put (\"\r\nCopy the certificate file \" . \$PeerName . \"@\" . \$Hostname . \".p12 from Files (WinBox: Files) to the peer device. Import it with the password you set.\")\r\n    }\r\n:if (variant = 3) do={\r\n    :put \"\"\r\n    :set \$Hostname  [\$inputFunc \"Input domain name of this server. (Example: vpn.example.com. Press ENTER to auto-detect from /ip cloud)\"]\r\n    :set \$Hostname [\$checkHostnameFunc \$Hostname]\r\n    :if (\$Hostname = \"\") do={\r\n             :put \"Error: cannot get DNS name of this router.\"\r\n             :set err \"true\"\r\n        }\r\n    :put \"\"\r\n    :set PeerName [\$inputFunc (\"Input peer name you want to remove. (Pattern: ike2_<user>_<device>_<issue year>, without @\" . \$Hostname . \")\")]\r\n    :put \"\"\r\n    :put \"\\r\\nChecking if script can use given parameters\\r\\n\"\r\n    :if ([/certificate find name=\"\$PeerName@\$Hostname\"] = \"\") do={\r\n             :put \"Error: there's no such peer \$PeerName@\$Hostname\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: peer name \$PeerName@\$Hostname\"\r\n        }\r\n    :if ([/ip ipsec identity find remote-id~\"\$PeerName@\$Hostname\"] = \"\") do={\r\n             :put \"Error: there's no such identity for \$PeerName@\$Hostname\"\r\n             :set err \"true\"\r\n        } else {\r\n             :put \"OK: identity for peer name \$PeerName@\$Hostname\"\r\n        }\r\n        \r\n    :if (\$err = \"true\") do={:error \"\\r\\nPrecheck failed\"} else={:put \"Precheck OK\"}\r\n    :put \"\\r\\n\"\r\n    :if ([\$inputFunc \"Remove peer\? [y/n]\"]=\"n\") do={:error \"Script stopped by user request\"}\r\n    :put \"Removing ipsec identity...\"\r\n    :do {/ip ipsec identity remove [find remote-id~\"\$PeerName@\$Hostname\"]} on-error={}\r\n    :put \"Revoking certificate...\"\r\n    :do {/certificate issued-revoke [find name=\"\$PeerName@\$Hostname\"]} on-error={}\r\n    :put \"Removing certificate from store...\"\r\n    :do {/certificate remove [find name=\"\$PeerName@\$Hostname\"]} on-error={}\r\n    :put \"Removing exported certificate files...\"\r\n    :do {/file remove [find name~\"\$PeerName@\$Hostname\"]} on-error={}\r\n    :put \"Removing rollback script...\"\r\n    :do {/system script remove [find name=\"\$PeerName-rollback\"]} on-error={}\r\n    }\r\n:if (variant = 4) do={\r\n    :put \"\\r\\nChecking if script can use given parameters\\r\\n\"\r\n    :if ([/system script find name=\"IKEv2-rollback\"] = \"\") do={\r\n             :put \"Error: cannot find rollback script IKEv2-rollback\"\r\n        } else {\r\n             :put \"OK: rollback script IKEv2-rollback found.\"\r\n             :do {/system script run [find name=\"IKEv2-rollback\"]} on-error={:error \"Error: script error in IKEv2-rollback\"}\r\n        }\r\n    }\r\n    \r\n    :put \"\\r\\nScript finished.\"\r\n}\r\n"
